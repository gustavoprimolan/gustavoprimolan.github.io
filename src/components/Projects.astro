---
import { projects, site } from '../data/site';
---

<section class="section projects" id="projects">
  <div class="container">
    <div class="section-header section-header-row">
      <div>
        <span class="section-tag">03 — Projects</span>
        <h2 class="section-title">Selected work</h2>
      </div>
      <a
        href={`${site.github}?tab=repositories`}
        target="_blank"
        rel="noopener noreferrer"
        class="link-arrow"
      >
        All repositories
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M7 17L17 7M17 7H7M17 7v10" />
        </svg>
      </a>
    </div>
    <div class="projects-grid" id="projects-grid">
      {
        projects.map((project) => (
          <article class="project-card">
            <div class="project-header">
              <svg class="project-folder" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z" />
              </svg>
              <a href={project.url} target="_blank" rel="noopener noreferrer" aria-label="View on GitHub">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </div>
            <h3>{project.name}</h3>
            <p>{project.description}</p>
            <span class="project-lang">{project.language}</span>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const GITHUB_USER = 'gustavoprimolan';
  const FEATURED_REPOS = [
    'hackathon-group-42',
    'blockchain-studies',
    'devops-studies',
    'game-dev-studies',
    'udemy-java',
    'ERPJavaWeb',
  ];

  async function fetchGitHubProjects() {
    const grid = document.getElementById('projects-grid');
    if (!grid) return;

    try {
      const response = await fetch(
        `https://api.github.com/users/${GITHUB_USER}/repos?sort=updated&per_page=100`
      );
      if (!response.ok) return;

      const repos = await response.json();
      const featured = FEATURED_REPOS.map((name) =>
        repos.find((r: { name: string }) => r.name === name)
      ).filter(Boolean);

      if (featured.length === 0) return;

      grid.innerHTML = featured
        .map(
          (repo: {
            html_url: string;
            name: string;
            description: string | null;
            language: string | null;
          }) => {
            const name = repo.name.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
            const desc = repo.description || `Explore ${repo.name} on GitHub.`;
            const lang = repo.language || 'Code';

            return `
              <article class="project-card">
                <div class="project-header">
                  <svg class="project-folder" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>
                  <a href="${repo.html_url}" target="_blank" rel="noopener noreferrer" aria-label="View on GitHub">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                  </a>
                </div>
                <h3>${name}</h3>
                <p>${desc}</p>
                <span class="project-lang">${lang}</span>
              </article>
            `;
          }
        )
        .join('');
    } catch {
      /* Static fallback remains */
    }
  }

  fetchGitHubProjects();
</script>
