---
import type { Locale } from '../i18n/types';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Skills from './Skills.astro';
import Projects from './Projects.astro';
import Accomplishments from './Accomplishments.astro';
import Experience from './Experience.astro';
import Education from './Education.astro';
import Contact from './Contact.astro';
import { getTranslations } from '../i18n/translations';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<BaseLayout title={t.meta.homeTitle} description={t.meta.homeDescription} lang={lang}>
  <Hero lang={lang} />
  <About lang={lang} />
  <Skills lang={lang} />
  <Projects lang={lang} />
  <Accomplishments lang={lang} limit={3} showViewAll />
  <Experience lang={lang} />
  <Education lang={lang} />
  <Contact lang={lang} />
</BaseLayout>
