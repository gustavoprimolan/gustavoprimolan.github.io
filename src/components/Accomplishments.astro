---
import { getCollection } from 'astro:content';
import type { Locale } from '../i18n/types';
import { getTranslations } from '../i18n/translations';
import { localizePath } from '../i18n/utils';

interface Props {
  lang: Locale;
  limit?: number;
  showViewAll?: boolean;
  showSectionHeader?: boolean;
}

const { lang, limit, showViewAll = false, showSectionHeader = true } = Astro.props;
const t = getTranslations(lang);

const allAccomplishments = await getCollection('accomplishments');
const sorted = allAccomplishments.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
const items = limit ? sorted.slice(0, limit) : sorted;

function formatDate(date: Date) {
  return date.toLocaleDateString(lang === 'pt' ? 'pt-BR' : 'en-US', {
    year: 'numeric',
    month: 'short',
  });
}

function localizedTitle(data: (typeof sorted)[0]['data']) {
  return lang === 'pt' && data.titlePt ? data.titlePt : data.title;
}

function localizedSummary(data: (typeof sorted)[0]['data']) {
  return lang === 'pt' && data.summaryPt ? data.summaryPt : data.summary;
}

function localizedAward(data: (typeof sorted)[0]['data']) {
  return lang === 'pt' && data.awardPt ? data.awardPt : data.award;
}
---

<section class="section accomplishments" id="accomplishments">
  <div class="container">
    {
      showSectionHeader && (
        <div class="section-header section-header-row">
          <div>
            <span class="section-tag">{t.accomplishments.tag}</span>
            <h2 class="section-title">{t.accomplishments.title}</h2>
          </div>
          {
            showViewAll && sorted.length > (limit ?? 0) && (
              <a href={localizePath(lang, '/accomplishments')} class="link-arrow">
                {t.accomplishments.viewAll}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M7 17L17 7M17 7H7M17 7v10" />
                </svg>
              </a>
            )
          }
        </div>
      )
    }

    {
      items.length === 0 ? (
        <p class="empty-state">{t.accomplishments.empty}</p>
      ) : (
        <div class="accomplishments-grid">
          {
            items.map(({ data }) => {
              const title = localizedTitle(data);
              const summary = localizedSummary(data);
              const award = localizedAward(data);

              return (
                <article class="accomplishment-card">
                  {data.image && (
                    <img
                      src={data.image}
                      alt={`${title}${award ? ` — ${award}` : ''}`}
                      class="accomplishment-image"
                      loading="lazy"
                    />
                  )}
                  <div class="accomplishment-meta">
                    <span class={`category-badge category-${data.category}`}>
                      {t.accomplishments.categories[data.category]}
                    </span>
                    {award && <span class="award-badge">{award}</span>}
                    <time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
                  </div>
                  <h3>{title}</h3>
                  <p class="accomplishment-issuer">{data.issuer}</p>
                  {summary && <p class="accomplishment-desc">{summary}</p>}
                  <div class="accomplishment-footer">
                    {data.credentialId && (
                      <span class="credential-id">ID: {data.credentialId}</span>
                    )}
                    {
                      data.url && (
                        <a href={data.url} target="_blank" rel="noopener noreferrer" class="link-arrow">
                          {t.accomplishments.verify}
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M7 17L17 7M17 7H7M17 7v10" />
                          </svg>
                        </a>
                      )
                    }
                  </div>
                </article>
              );
            })
          }
        </div>
      )
    }
  </div>
</section>
