---
import type { Locale } from '../i18n/types';
import { getTranslations } from '../i18n/translations';
import { site } from '../data/site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section class="hero" id="hero">
  <div class="container hero-grid">
    <div class="hero-content">
      {
        site.available && (
          <p class="hero-eyebrow">
            <span class="status-dot"></span>
            {t.hero.available}
          </p>
        )
      }
      <h1 class="hero-title">
        Gustavo<br />
        <em>Primolan</em>
      </h1>
      <p class="hero-subtitle">
        {t.hero.subtitleBefore} <strong>{site.company}</strong> {t.hero.subtitleAfter}
      </p>
      <div class="hero-actions">
        <a href="#projects" class="btn btn-primary">{t.hero.viewWork}</a>
        <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          LinkedIn
        </a>
        <a href={site.instagram} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          Instagram
        </a>
      </div>
      <div class="hero-stats">
        <div class="stat">
          <span class="stat-value">{site.publicRepos}+</span>
          <span class="stat-label">{t.hero.publicRepos}</span>
        </div>
        <div class="stat">
          <span class="stat-value stat-value-location">
            <span class="location-flag" aria-hidden="true">🇧🇷</span>
            {t.hero.locationName}
          </span>
          <span class="stat-label">{t.hero.basedIn}</span>
        </div>
        <div class="stat">
          <span class="stat-value">{site.codingSince}</span>
          <span class="stat-label">{t.hero.codingSince}</span>
        </div>
      </div>
    </div>
    <div class="hero-visual">
      <div class="avatar-ring">
        <img
          src={site.avatar}
          alt={site.name}
          class="avatar"
          width="280"
          height="280"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="hero-orbit hero-orbit-1"></div>
      <div class="hero-orbit hero-orbit-2"></div>
    </div>
  </div>
  <a href="#about" class="scroll-hint" aria-label={t.hero.scrollAria}>
    <span>{t.hero.scroll}</span>
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M12 5v14M5 12l7 7 7-7" />
    </svg>
  </a>
</section>
