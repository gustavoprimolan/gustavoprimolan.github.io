---
import type { Locale } from '../i18n/types';
import { localeLabels, locales } from '../i18n/types';
import { switchLangPath } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const pathname = Astro.url.pathname;
---

<div class="lang-switcher" role="navigation" aria-label="Language">
  {
    locales.map((locale) => {
      const isActive = locale === lang;
      const href = switchLangPath(pathname, locale);

      return (
        <a
          href={href}
          class:list={['lang-switcher-link', { active: isActive }]}
          hreflang={locale}
          lang={locale}
          aria-current={isActive ? 'page' : undefined}
          aria-label={`${localeLabels[locale]}${isActive ? ' (current)' : ''}`}
        >
          {localeLabels[locale]}
        </a>
      );
    })
  }
</div>
