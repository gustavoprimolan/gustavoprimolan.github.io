---
import type { Locale } from '../i18n/types';
import { getTranslations } from '../i18n/translations';
import { site } from '../data/site';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
---

<section class="section about" id="about">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">{t.about.tag}</span>
      <h2 class="section-title">{t.about.title}</h2>
    </div>
    <div class="about-grid">
      <div class="about-text">
        <p class="lead">
          {t.about.leadBefore}{' '}
          <a href={site.companyUrl} target="_blank" rel="noopener noreferrer">{site.company}</a>
          {t.about.leadAfter}
        </p>
        <p>{t.about.p2}</p>
        <p>{t.about.p3}</p>
        <div class="about-interests">
          <h3 class="about-interests-label">{t.about.outsideWork}</h3>
          <ul class="interest-tags">
            {t.interests.map((interest) => (
              <li>{interest}</li>
            ))}
          </ul>
        </div>
      </div>
      <aside class="about-card">
        <h3>{t.about.quickFacts}</h3>
        <dl>
          <div>
            <dt>{t.about.location}</dt>
            <dd>{site.location}</dd>
          </div>
          <div>
            <dt>{t.about.company}</dt>
            <dd>{site.company}</dd>
          </div>
          <div>
            <dt>{t.about.focus}</dt>
            <dd>{t.about.focusValue}</dd>
          </div>
          <div>
            <dt>{t.about.languages}</dt>
            <dd>{t.about.languagesValue}</dd>
          </div>
          <div>
            <dt>{t.about.alsoInto}</dt>
            <dd>{t.about.alsoIntoValue}</dd>
          </div>
        </dl>
      </aside>
    </div>
  </div>
</section>
