---
import BaseLayout from './BaseLayout.astro';
import type { Locale } from '../i18n/types';
import { getTranslations } from '../i18n/translations';
import { dateLocale, localizePath } from '../i18n/utils';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
}

const { lang, title, description, pubDate, updatedDate, tags = [] } = Astro.props;
const t = getTranslations(lang);
const locale = dateLocale(lang);

const formattedDate = pubDate.toLocaleDateString(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdated = updatedDate?.toLocaleDateString(locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} | Gustavo Primolan`} description={description} lang={lang}>
  <article class="section page-content">
    <div class="container content-narrow">
      <a href={localizePath(lang, '/blog')} class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 12H5M12 19l-7-7 7-7" />
        </svg>
        {t.blog.backToBlog}
      </a>
      <header class="post-header">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        <h1>{title}</h1>
        <p class="post-description">{description}</p>
        {
          tags.length > 0 && (
            <ul class="post-tags">
              {tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )
        }
        {
          formattedUpdated && (
            <p class="post-updated">
              {lang === 'pt' ? 'Atualizado em' : 'Updated'} {formattedUpdated}
            </p>
          )
        }
      </header>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
