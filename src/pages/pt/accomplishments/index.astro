---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Accomplishments from '../../../components/Accomplishments.astro';
import { getTranslations } from '../../../i18n/translations';

const lang = 'pt';
const t = getTranslations(lang);
---

<BaseLayout
  title={t.meta.accomplishmentsTitle}
  description={t.meta.accomplishmentsDescription}
  lang={lang}
>
  <section class="section page-content page-content-top">
    <div class="container">
      <div class="page-header">
        <span class="section-tag">{t.accomplishments.pageTag}</span>
        <h1 class="section-title">{t.accomplishments.pageTitle}</h1>
        <p class="page-intro">{t.accomplishments.pageIntro}</p>
      </div>
    </div>
  </section>
  <Accomplishments lang={lang} showSectionHeader={false} />
</BaseLayout>
